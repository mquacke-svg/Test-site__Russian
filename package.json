{
  "name": "jacques-andre-bakery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  },
  "scripts": {
    "dev": "concurrently -k -n web,telegram \"next dev --hostname 127.0.0.1\" \"npm run notifications\"",
    "build": "next build",
    "start": "concurrently -k -n web,telegram \"next start --hostname 127.0.0.1\" \"npm run notifications\"",
    "setup": "node --env-file-if-exists=.env.local --import tsx scripts/setup.ts",
    "db:generate": "drizzle-kit generate",
    "admin:create": "node --env-file-if-exists=.env.local --import tsx scripts/admin.ts",
    "notifications": "node --env-file-if-exists=.env.local --import tsx scripts/notifications.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:isolated": "node --import tsx scripts/test-e2e.ts",
    "backup": "node --env-file-if-exists=.env.local --import tsx scripts/backup.ts",
    "restore": "node --env-file-if-exists=.env.local --import tsx scripts/restore.ts"
  },
  "dependencies": {
    "better-auth": "^1.7.13",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
